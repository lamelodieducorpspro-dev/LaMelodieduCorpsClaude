{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },

  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(yarn *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)"
    ]
  }
}
